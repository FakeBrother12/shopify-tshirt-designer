generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)
}
model Design {
  id             String   @id @default(cuid())
  shop           String
  customerEmail  String?
  productId      String
  variantId      String
  productTitle   String
  variantTitle   String?
  quantity       Int      @default(1)
  size           String?
  color          String?
  designJson     Json
  frontObjectKey String?
  backObjectKey  String?
  draftOrderId   String?
  invoiceUrl     String?
  status         String   @default("DESIGN_SAVED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([shop, createdAt])
  @@index([shop, draftOrderId])
}
